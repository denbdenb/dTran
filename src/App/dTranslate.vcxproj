    <ProjectGuid>{7B3A6E5C-2D41-4F8A-9C1E-5A0B6D3F2E11}</ProjectGuid>
    <ProjectName>dTranslate</ProjectName>
    <RootNamespace>dTranslate</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
