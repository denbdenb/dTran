// Win32 resource file for dTran
#include <windows.h>

// Application icon (ID 1: used by Windows Explorer, Taskbar, and Alt+Tab)
1 ICON "../../assets/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "dTran"
            VALUE "FileDescription",  "dTran - Lightweight System Translator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "dTran"
            VALUE "LegalCopyright",   "Copyright (C) 2026 denb. All rights reserved."
            VALUE "OriginalFilename", "dTranslate.exe"
            VALUE "ProductName",      "dTran"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
