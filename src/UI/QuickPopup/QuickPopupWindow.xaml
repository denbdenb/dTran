<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="dTranslate.QuickPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="dTranslate - Quick Translation">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="PopupRootGrid" Padding="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header / Draggable Title Bar -->
        <Grid x:Name="PopupTitleBar" Grid.Row="0" Background="Transparent" Margin="-14,-8,-14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="6">
                <Border Width="18" Height="18" CornerRadius="4" Background="#2563EB">
                    <TextBlock Text="dT" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="dTranslate" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="4">
                <Button x:Name="PopupCloseBtn" Width="26" Height="26" CornerRadius="4"
                        Background="Transparent" BorderThickness="0" Padding="0" ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Language Selectors & Swap -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="PopupSourceLanguageCombo" Grid.Column="0" HorizontalAlignment="Stretch" Height="32" CornerRadius="6" />

            <Button x:Name="PopupSwapLanguagesBtn" Grid.Column="1" Width="32" Height="32" CornerRadius="6"
                    Margin="6,0,6,0" Padding="0" ToolTipService.ToolTip="Swap Languages">
                <FontIcon Glyph="&#xE8AB;" FontSize="12" />
            </Button>

            <ComboBox x:Name="PopupTargetLanguageCombo" Grid.Column="2" HorizontalAlignment="Stretch" Height="32" CornerRadius="6" />
        </Grid>

        <!-- 2. Selected Text Card -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,10" MinHeight="75">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Selected text" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="PopupClearTextBtn" HorizontalAlignment="Right" Width="20" Height="20"
                            Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Clear">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PopupSelectedTextBlock" TextWrapping="Wrap" FontSize="13"
                               Text="The quick brown fox jumps over the lazy dog." />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Translate Action Button -->
        <Button x:Name="PopupTranslateActionBtn" Grid.Row="3" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch" Height="34" CornerRadius="6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="White" />
                <TextBlock Text="Translate" FontSize="13" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
        </Button>

        <!-- 4. Result Area Card -->
        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,10" MinHeight="75">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="PopupResultTextBlock" TextWrapping="Wrap" AcceptsReturn="True"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                             FontSize="13" Text="Быстрая коричневая лиса перепрыгивает через ленивую собаку." />
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,4,0,0">
                    <Button x:Name="PopupSpeakBtn" Width="26" Height="26" CornerRadius="4"
                            Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Listen (TTS)">
                        <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button x:Name="PopupCopyResultBtn" Width="26" Height="26" CornerRadius="4"
                            Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Copy translation">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Bottom Services Row -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Google -->
            <Button x:Name="PopupServiceGoogleBtn" Grid.Column="0" HorizontalAlignment="Stretch" Height="36"
                    CornerRadius="6" Margin="0,0,3,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#2563EB" BorderThickness="1.5" ToolTipService.ToolTip="Google Translate">
                <Border Width="18" Height="18" CornerRadius="3" Background="#E8F0FE">
                    <TextBlock Text="G" FontWeight="Bold" FontSize="11" Foreground="#1A73E8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>

            <!-- Yandex -->
            <Button x:Name="PopupServiceYandexBtn" Grid.Column="1" HorizontalAlignment="Stretch" Height="36"
                    CornerRadius="6" Margin="3,0,3,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Yandex Translate">
                <Border Width="18" Height="18" CornerRadius="3" Background="#FC0">
                    <TextBlock Text="Y" FontWeight="Bold" FontSize="11" Foreground="#D00"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>

            <!-- Gemini -->
            <Button x:Name="PopupServiceGeminiBtn" Grid.Column="2" HorizontalAlignment="Stretch" Height="36"
                    CornerRadius="6" Margin="3,0,3,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Google Gemini">
                <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="#1E88E5" />
            </Button>

            <!-- OpenAI -->
            <Button x:Name="PopupServiceOpenAiBtn" Grid.Column="3" HorizontalAlignment="Stretch" Height="36"
                    CornerRadius="6" Margin="3,0,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="OpenAI">
                <Path Data="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.8956zm16.0993 3.8558L12.5973 8.3829l2.02-1.1638a.0804.0804 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.4019-.686zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.407 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813l-.0048 6.7227zm1.145-2.0734l2.5516-1.4722 2.5516 1.4722v2.9444l-2.5516 1.4722-2.5516-1.4722z"
                      Fill="#10A37F" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Grid>
</Window>
