<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="dTranslate.QuickPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="dTran - Quick Translator">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="PopupRootGrid" Padding="14,8,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header / Title Bar -->
        <Grid x:Name="PopupTitleBar" Grid.Row="0" Background="Transparent" Margin="-14,-8,-14,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="6">
                <Border Width="18" Height="18" CornerRadius="4" Background="#2563EB">
                    <TextBlock Text="dT" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="dTran" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="4">
                <Button x:Name="PopupCloseBtn" Visibility="Collapsed" Width="26" Height="26" CornerRadius="4"
                        Background="Transparent" BorderThickness="0" Padding="0" ToolTipService.ToolTip="Hide (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Top Language Row: Source | Swap | Target | Restore Defaults | Spacer | OCR -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="135" MaxWidth="175" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="135" MaxWidth="175" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Source Language -->
            <ComboBox x:Name="PopupSourceLanguageCombo" Grid.Column="0" HorizontalAlignment="Stretch" Height="30" CornerRadius="5" FontSize="12" />

            <!-- Swap Languages Button -->
            <Button x:Name="PopupSwapLanguagesBtn" Grid.Column="1" Width="30" Height="30" CornerRadius="5"
                    Margin="4,0,4,0" Padding="0" ToolTipService.ToolTip="Swap languages">
                <FontIcon Glyph="&#xE8AB;" FontSize="12" />
            </Button>

            <!-- Target Language -->
            <ComboBox x:Name="PopupTargetLanguageCombo" Grid.Column="2" HorizontalAlignment="Stretch" Height="30" CornerRadius="5" FontSize="12" />

            <!-- Restore Defaults Button (icon-only) -->
            <Button x:Name="PopupRestoreDefaultsBtn" Grid.Column="3" Width="30" Height="30" CornerRadius="5"
                    Margin="4,0,0,0" Padding="0" ToolTipService.ToolTip="Restore default languages">
                <FontIcon Glyph="&#xE777;" FontSize="12" />
            </Button>

            <!-- Spacer column (Grid.Column 4) fills remaining space -->

            <!-- OCR Button (icon-only) aligned to right of text fields -->
            <Button x:Name="PopupOcrBtn" Grid.Column="5" Width="30" Height="30" CornerRadius="5"
                    Padding="0" ToolTipService.ToolTip="Screen OCR and translate">
                <FontIcon Glyph="&#xEE6F;" FontSize="12" />
            </Button>
        </Grid>

        <!-- 2. Middle Content Area: Translation Views or Inline History View -->
        <Grid Grid.Row="2" Margin="0,0,0,8">

            <!-- 2A. Translation Cards -->
            <Grid x:Name="PopupTranslateGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="85" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="85" />
                </Grid.RowDefinitions>

                <!-- Source / Input Text Card -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="10,6,10,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="PopupSourceHeaderTextBlock" Text="Source text" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PopupCharCountTextBlock" Text="0 chars" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button x:Name="PopupSourceSpeakBtn" Width="24" Height="24" CornerRadius="4"
                                        Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Listen (TTS)">
                                    <FontIcon x:Name="PopupSourceSpeakIcon" Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                                <Button x:Name="PopupClearTextBtn" Width="24" Height="24" CornerRadius="4"
                                        Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Clear">
                                    <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Editable Multiline Input -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="PopupSourceTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" Padding="0" FontSize="13"
                                     PlaceholderText="Enter or paste text to translate..." />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Translate Action Button -->
                <Button x:Name="PopupTranslateActionBtn" Grid.Row="1" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Height="32" CornerRadius="5" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="White" />
                        <TextBlock x:Name="PopupTranslateActionText" Text="Translate" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>

                <!-- Result Area Card -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="10,6,10,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Multiline Result Output -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="PopupResultTextBlock" TextWrapping="Wrap" AcceptsReturn="True"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontSize="13" PlaceholderText="Translation will appear here..." />
                        </ScrollViewer>

                        <!-- Bottom Result Actions: TTS, Replace Source Text, Copy -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,4,0,0">
                            <!-- Speak TTS -->
                            <Button x:Name="PopupSpeakBtn" Width="26" Height="26" CornerRadius="4"
                                    Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Listen (TTS)">
                                <FontIcon x:Name="PopupSpeakResultIcon" Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <!-- Replace Source Text (icon-only, adjacent to Copy) -->
                            <Button x:Name="PopupReplaceBtn" Width="26" Height="26" CornerRadius="4"
                                    Padding="0" Background="Transparent" BorderThickness="0"
                                    IsEnabled="False" ToolTipService.ToolTip="Replace selected text in active window">
                                <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <!-- Copy Translation -->
                            <Button x:Name="PopupCopyResultBtn" Width="26" Height="26" CornerRadius="4"
                                    Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Copy translation">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2B. Inline History View -->
            <Grid x:Name="PopupHistoryGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="PopupHistorySearchBox" Grid.Row="0" PlaceholderText="Search history..."
                         Height="30" CornerRadius="4" Margin="0,0,0,6" FontSize="12" />

                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="6">
                    <ListView x:Name="PopupHistoryListView" SelectionMode="Single" FontSize="12" />
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,6,0,0">
                    <Button x:Name="PopupHistoryInsertBtn" Height="28" CornerRadius="4" FontSize="11" Content="Insert" />
                    <Button x:Name="PopupHistoryCopyBtn" Height="28" CornerRadius="4" FontSize="11" Content="Copy" />
                    <Button x:Name="PopupHistoryClearBtn" Height="28" CornerRadius="4" FontSize="11" Content="Clear" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 3. Bottom Toolbar: Left: Google | Yandex; Right: History | Settings -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Google & Yandex Buttons (Icon + Service Name) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <!-- Google Button -->
                <Button x:Name="PopupServiceGoogleBtn" Height="32" CornerRadius="5" Padding="8,0,10,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="#2563EB" BorderThickness="1.5" ToolTipService.ToolTip="Google Translate">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Proper Viewbox avoiding any clipping -->
                        <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="18" Height="18">
                                <Path Fill="#4285F4" Data="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z" />
                                <Path Fill="#34A853" Data="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" />
                                <Path Fill="#FBBC05" Data="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.173 0 7.547 0 9s.347 2.827.957 4.039l3.007-2.332z" />
                                <Path Fill="#EA4335" Data="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="PopupServiceGoogleText" Text="Google" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Yandex Button -->
                <Button x:Name="PopupServiceYandexBtn" Height="32" CornerRadius="5" Padding="8,0,10,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="Yandex Translate">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="#FC3F1D" Width="16" Height="16" VerticalAlignment="Center">
                            <Path Fill="White" Width="8" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M7.7 0H4.3C2 0 .4 1.5.4 3.6c0 1.9 1 3.1 2.5 3.7L.2 12.3h2.3l2.5-4.7h.8v4.7h2v-12h-.1zm-2 5.6H4.2c-1.1 0-1.9-.7-1.9-1.9 0-1.2.8-1.9 1.9-1.9h1.5v3.8z" />
                        </Border>
                        <TextBlock x:Name="PopupServiceYandexText" Text="Yandex" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Spacer column (Grid.Column 1) -->

            <!-- Right: History & Settings Buttons (icon-only, aligned to right edge of text cards) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button x:Name="PopupHistoryBtn" Width="32" Height="32" CornerRadius="5"
                        Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="Translation history">
                    <FontIcon x:Name="PopupHistoryBtnIcon" Glyph="&#xE81C;" FontSize="13" />
                </Button>

                <Button x:Name="PopupSettingsBtn" Width="32" Height="32" CornerRadius="5"
                        Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
