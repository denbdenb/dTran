<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="dTranslate.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="dTranslate - Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="SettingsRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Title Bar -->
        <Grid x:Name="SettingsTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="8">
                <Border Width="18" Height="18" CornerRadius="4" Background="#2563EB">
                    <TextBlock Text="dT" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 1. Main Content: Sidebar + Panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings Left Sidebar -->
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                    Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid Padding="12,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,16">
                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="#2563EB" />
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" Spacing="3">
                        <Button x:Name="TabGeneralBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#2563EB" />
                                <TextBlock Text="General" FontSize="13" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabTranslationBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Translation" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabAiBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="AI" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabDictionariesBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE82D;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Dictionaries" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabSpeechBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE767;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Speech (TTS)" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabOcrBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8FF;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="OCR" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabHotkeysBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Hotkeys" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabAboutBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="About" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings Right Content: Services Grid matching concept screenshot -->
            <ScrollViewer Grid.Column="1" Padding="24,14,24,14">
                <StackPanel Spacing="16">
                    <TextBlock Text="Services" FontSize="18" FontWeight="SemiBold" />

                    <!-- Two-column Services Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Translators & AI -->
                        <StackPanel Grid.Column="0" Spacing="16">
                            <!-- Translators Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Translators" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Google Translate Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Background="#E8F0FE" Margin="0,0,10,0">
                                            <TextBlock Text="G" FontWeight="Bold" FontSize="14" Foreground="#1A73E8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Google Translate" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Primary translator" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleGoogle" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Yandex Translate Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Background="#FC0" Margin="0,0,10,0">
                                            <TextBlock Text="Y" FontWeight="Bold" FontSize="14" Foreground="#D00"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Yandex Translate" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Alternative translator" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleYandex" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- AI Services Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="AI Services" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Gemini Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE945;" FontSize="20" Foreground="#1E88E5" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Gemini" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Translate, rewrite, summary" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleGemini" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure API key">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- OpenAI Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="18" Foreground="#10A37F" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="OpenAI" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Translate, rewrite, summary" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleOpenAi" Grid.Column="2" IsOn="False" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure API key">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Dictionaries & Other -->
                        <StackPanel Grid.Column="2" Spacing="16">
                            <!-- Dictionaries Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Dictionaries" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Reverso Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE82D;" FontSize="19" Foreground="#2563EB" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Reverso" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Translation, examples, definitions" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleReverso" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Wikipedia Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="W" FontSize="19" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Wikipedia" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Search &amp; reference" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleWikipedia" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Other Services Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Other Services" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Google TTS Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="19" Foreground="#2563EB" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Google TTS" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Text to speech" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleTts" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure voice">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Windows OCR Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10,12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8FF;" FontSize="19" Foreground="#2563EB" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Windows OCR" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Text recognition" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleOcr" Grid.Column="2" IsOn="True" MinWidth="0" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent"
                                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Configure languages">
                                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- API Keys Section (Windows Credential Manager) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14,16,14" Margin="0,8,0,0">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#2563EB" />
                                <TextBlock Text="API Keys &amp; Credentials (Stored in Windows Credential Manager)"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Gemini Key -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Gemini API Key" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <PasswordBox x:Name="KeyGeminiBox" PlaceholderText="AIzaSy..." Height="34" CornerRadius="6" />
                                </StackPanel>

                                <!-- OpenAI Key -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="OpenAI API Key" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <PasswordBox x:Name="KeyOpenAiBox" PlaceholderText="sk-proj-..." Height="34" CornerRadius="6" />
                                </StackPanel>

                                <!-- Yandex Key -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Yandex Translate API Key" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <PasswordBox x:Name="KeyYandexBox" PlaceholderText="Api-Key..." Height="34" CornerRadius="6" />
                                </StackPanel>

                                <!-- Google Cloud Key -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Google Cloud API Key (Optional)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <PasswordBox x:Name="KeyGoogleBox" PlaceholderText="Leave empty for instant translation..." Height="34" CornerRadius="6" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="CompareTranslationsCheck" Content="Compare Google and Yandex translations side-by-side" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 2. Bottom Actions: Save & Cancel -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,12,24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="SettingsSaveBtn" Style="{StaticResource AccentButtonStyle}"
                        Content="Save" Width="100" Height="36" CornerRadius="6" />
                <Button x:Name="SettingsCancelBtn" Content="Cancel" Width="90" Height="36" CornerRadius="6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
