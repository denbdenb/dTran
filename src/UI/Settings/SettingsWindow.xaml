<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="dTranslate.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="dTranslate - Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="SettingsRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Title Bar -->
        <Grid x:Name="SettingsTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="8">
                <Border Width="18" Height="18" CornerRadius="4" Background="#2563EB">
                    <TextBlock Text="dT" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 1. Main Content: Sidebar + Panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings Left Sidebar -->
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                    Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid Padding="10,12,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,16">
                        <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="#2563EB" />
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Nav Items (General, Translation, AI, Hotkeys, About) -->
                    <StackPanel Grid.Row="1" Spacing="3">
                        <Button x:Name="TabGeneralBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#2563EB" />
                                <TextBlock Text="General" FontSize="13" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabTranslationBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Translation" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabAiBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="AI Services" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabHotkeysBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Hotkeys" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabAboutBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="36" CornerRadius="6" Background="Transparent"
                                BorderThickness="0" Padding="10,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="About" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings Right Content Area -->
            <ScrollViewer Grid.Column="1" Padding="24,14,24,14">
                <Grid>
                    <!-- TAB 0: GENERAL -->
                    <StackPanel x:Name="PanelGeneral" Spacing="14" Visibility="Visible">
                        <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />

                        <!-- Appearance Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Application Theme" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Select light, dark, or system default color scheme"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="130" Height="34" CornerRadius="6" VerticalAlignment="Center">
                                    <ComboBoxItem Content="System Default" IsSelected="True" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Auto-Start Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Start with Windows" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Launch dTranslate minimized to the system tray upon system startup"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Minimize to Tray Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Close Button Minimizes to Tray" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Keep global translation hotkeys active when the window is closed"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- TAB 1: TRANSLATION -->
                    <StackPanel x:Name="PanelTranslation" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Translation" FontSize="18" FontWeight="SemiBold" />

                        <!-- Default Languages Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Default Languages" FontWeight="Medium" FontSize="14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Default Source Language" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="DefaultSourceLangCombo" HorizontalAlignment="Stretch" Height="34" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Default Target Language" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="DefaultTargetLangCombo" HorizontalAlignment="Stretch" Height="34" CornerRadius="6" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Compare Translations Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Translation Comparison" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Compare primary translation with secondary engine"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox x:Name="CompareTranslationsCheck" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: AI SERVICES -->
                    <StackPanel x:Name="PanelAi" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="3">
                            <TextBlock Text="AI Services" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Configure external AI keys. Credentials are encrypted and securely stored in Windows Credential Manager."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Gemini Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="5" Background="#E8F0FE">
                                            <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="#1E88E5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Google Gemini" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="GeminiStatusText" Text="Not configured" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="API Key" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <PasswordBox x:Name="KeyGeminiBox" PlaceholderText="Paste Gemini API key..." Height="34" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Model" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ModelGeminiCombo" IsEditable="True" Height="34" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                                            <Button x:Name="RefreshGeminiModelsBtn" Grid.Column="1" Width="34" Height="34" CornerRadius="6" Padding="0" ToolTipService.ToolTip="Discover models from Gemini">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="TestGeminiBtn" Content="Test Connection" Height="32" CornerRadius="6" />
                                    <TextBlock x:Name="GeminiTestResultText" Text="" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OpenAI Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="5" Background="#E6F4EA">
                                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#10A37F"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="OpenAI" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="OpenAiStatusText" Text="Not configured" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="API Key" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <PasswordBox x:Name="KeyOpenAiBox" PlaceholderText="Paste OpenAI API key (sk-...)" Height="34" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Model" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ModelOpenAiCombo" IsEditable="True" Height="34" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                                            <Button x:Name="RefreshOpenAiModelsBtn" Grid.Column="1" Width="34" Height="34" CornerRadius="6" Padding="0" ToolTipService.ToolTip="Discover models from OpenAI">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="TestOpenAiBtn" Content="Test Connection" Height="32" CornerRadius="6" />
                                    <TextBlock x:Name="OpenAiTestResultText" Text="" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: HOTKEYS -->
                    <StackPanel x:Name="PanelHotkeys" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Global Hotkeys" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Configure shortcuts for quick translation actions. Use modifier keys (Ctrl, Alt, Shift, Win) + a key."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Hotkey 1: Translate Selection -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Translate Selected Text" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Capture highlighted text in any application and show Quick Translation popup"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="HotkeySelectionBox" Grid.Column="1" Text="Ctrl+Alt+T" Width="160" Height="34" CornerRadius="6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Hotkey 2: Show Main Window -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Show Main Window" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Bring the dTranslate workspace to the foreground"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="HotkeyMainBox" Grid.Column="1" Text="Ctrl+Alt+D" Width="160" Height="34" CornerRadius="6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Hotkey 3: Screen OCR & Translate -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Screen OCR &amp; Translate" FontWeight="Medium" FontSize="14" />
                                    <TextBlock Text="Snip any screen region and automatically recognize and translate text"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="HotkeyOcrBox" Grid.Column="1" Text="Ctrl+Alt+O" Width="160" Height="34" CornerRadius="6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="HotkeyResetBtn" Content="Reset to Defaults" Height="32" CornerRadius="6" />
                            <TextBlock x:Name="HotkeyStatusText" Text="" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- TAB 4: ABOUT -->
                    <StackPanel x:Name="PanelAbout" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />

                        <!-- App Info Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="34" Height="34" CornerRadius="6" Background="#2563EB">
                                        <TextBlock Text="dT" Foreground="White" FontSize="15" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="dTranslate" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Version 1.0.0 (Native Windows 11)" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Lightweight native Windows 11 translation assistant built with C++20, C++/WinRT, WinUI 3, and WinHTTP."
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- System & Services Status -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Diagnostics &amp; Integrations" FontWeight="Medium" FontSize="14" />
                                <TextBlock Text="• Google Translate: Built-in web client (no key required)&#x0a;• Yandex Translate: Built-in web client (no key required)&#x0a;• Speech (TTS): Native streaming MP3 audio player&#x0a;• OCR: Windows 11 Native Media.Ocr Engine&#x0a;• Memory Consumption: ~43 MB private working set"
                                           FontSize="12" LineHeight="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Unofficial Web Disclaimer -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Service Disclaimer" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Google Translate and Yandex Translate endpoints are unofficial web integrations intended for personal desktop translation without cloud API keys. Availability depends on upstream web service endpoints."
                                           FontSize="11" LineHeight="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 2. Bottom Actions Bar -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorAltBrush}" Padding="16,10,16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="SettingsCancelBtn" Content="Cancel" Width="90" Height="32" CornerRadius="6" />
                <Button x:Name="SettingsSaveBtn" Content="Save &amp; Close" Style="{StaticResource AccentButtonStyle}"
                        Width="120" Height="32" CornerRadius="6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
