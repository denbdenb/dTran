<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="dTranslate.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="dTran - Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="SettingsRootGrid" Padding="18,10,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Title Bar -->
        <Grid x:Name="SettingsTitleBar" Grid.Row="0" Background="Transparent" Margin="-18,-10,-18,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" Spacing="8">
                <Border Width="18" Height="18" CornerRadius="4" Background="#2563EB">
                    <TextBlock Text="dT" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SettingsTitleTextBlock" Text="dTran Settings" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 1. Single Page Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,8,0">

            <!-- Section 1: General -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8,12,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SettingsSectionGeneralText" Text="General" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />

                    <!-- Theme Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsThemeLabel" Text="Theme" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch" Height="28" CornerRadius="4">
                            <ComboBoxItem x:Name="ThemeItemDefault" Content="System default" />
                            <ComboBoxItem x:Name="ThemeItemLight" Content="Light" />
                            <ComboBoxItem x:Name="ThemeItemDark" Content="Dark" />
                        </ComboBox>
                    </Grid>

                    <!-- Application Language Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsAppLanguageLabel" Text="Application language" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox x:Name="AppLanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch" Height="28" CornerRadius="4">
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Русский" />
                        </ComboBox>
                    </Grid>

                    <!-- Start with Windows Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsAutoStartLabel" Text="Start with Windows" VerticalAlignment="Center" FontSize="12" />
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,-6,0,-6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Languages & Translation -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8,12,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SettingsSectionLanguagesText" Text="Languages &amp; Translation" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="SettingsDefaultSourceLabel" Text="Default source" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ComboBox x:Name="DefaultSourceLangCombo" HorizontalAlignment="Stretch" Height="28" CornerRadius="4" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="SettingsDefaultTargetLabel" Text="Default target" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ComboBox x:Name="DefaultTargetLangCombo" HorizontalAlignment="Stretch" Height="28" CornerRadius="4" />
                        </StackPanel>
                    </Grid>

                    <!-- Compare Translations ToggleSwitch -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsCompareTranslationsLabel" Text="Compare Google and Yandex translations" VerticalAlignment="Center" FontSize="12" />
                        <ToggleSwitch x:Name="CompareTranslationsToggle" Grid.Column="1" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,-6,0,-6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Hotkeys -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8,12,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SettingsSectionHotkeysText" Text="Hotkeys" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsHotkeyTranslateLabel" Text="Translate selected" VerticalAlignment="Center" FontSize="12" />
                        <TextBox x:Name="HotkeyTranslateBox" Grid.Column="1" Height="28" CornerRadius="4"
                                 IsReadOnly="True" FontSize="11" TextAlignment="Center" ToolTipService.ToolTip="Click and press key combination" />
                        <Button x:Name="ResetTranslateHotkeyBtn" Grid.Column="2" Width="28" Height="28" CornerRadius="4"
                                Padding="0" Margin="6,0,0,0" ToolTipService.ToolTip="Reset to default (Ctrl+Alt+T)">
                            <FontIcon Glyph="&#xE777;" FontSize="11" />
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsHotkeyOcrLabel" Text="Screen OCR &amp; translate" VerticalAlignment="Center" FontSize="12" />
                        <TextBox x:Name="HotkeyOcrBox" Grid.Column="1" Height="28" CornerRadius="4"
                                 IsReadOnly="True" FontSize="11" TextAlignment="Center" ToolTipService.ToolTip="Click and press key combination" />
                        <Button x:Name="ResetOcrHotkeyBtn" Grid.Column="2" Width="28" Height="28" CornerRadius="4"
                                Padding="0" Margin="6,0,0,0" ToolTipService.ToolTip="Reset to default (Ctrl+Alt+O)">
                            <FontIcon Glyph="&#xE777;" FontSize="11" />
                        </Button>
                    </Grid>

                    <TextBlock x:Name="HotkeyStatusText" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,-2,0,0" />
                </StackPanel>
            </Border>

            <!-- Section 4: About -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8,12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="dT" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="dTran" FontSize="13" FontWeight="Bold" />
                            <TextBlock x:Name="SettingsAboutVersionText" Text="v1.0 beta1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SettingsAboutSubtitleText" Text="Lightweight system translator for Google &amp; Yandex" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="SettingsAboutAuthorText" Text="Created with ❤️ by denb" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Bottom Close / Done Button -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="SettingsCloseBtn" HorizontalAlignment="Right" Width="90" Height="30" CornerRadius="4"
                    Style="{StaticResource AccentButtonStyle}" Content="Close" />
        </Grid>
    </Grid>
</Window>
